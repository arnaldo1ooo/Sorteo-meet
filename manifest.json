{
  "manifest_version": 3,
  "name": "Sorteo para Meet",
  "version": "1.4.5",
  "description": "Sorteá quién presenta (o lo que quieras) entre las personas que están en tu reunión de Google Meet, con ruleta o tragamonedas.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://chat.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sorteo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.google.com/*"
      ],
      "js": [
        "chat-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}